# Cole em Settings > Secrets do Streamlit Cloud ou copie para
# .streamlit/secrets.toml no desenvolvimento. Nunca publique os valores reais.

[google_credentials]
# Use um cliente OAuth do tipo Web application.
client_id = "SEU_CLIENT_ID"
client_secret = "SEU_CLIENT_SECRET"
# No primeiro acesso, deixe vazio ou remova este campo.
# Depois do consentimento, copie manualmente o token exibido no painel.
refresh_token = ""
token_uri = "https://oauth2.googleapis.com/token"
# O app detecta sua URL pelo navegador. Cadastre-a exatamente em
# Authorized redirect URIs do cliente Web, incluindo a barra final.
# Opcional, para fixar explicitamente o endereço de retorno:
# redirect_uri = "https://api-classroom-entregas.streamlit.app/"

# Sem nenhuma seção Google nos Secrets, o app usa credentials.json/token.json.
# [google_oauth] permanece aceito para compatibilidade; não configure ambas.
